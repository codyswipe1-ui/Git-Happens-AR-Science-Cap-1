# Copy this file to .env.local and fill in your values.
# .env.local is ignored by Git. Never commit real keys.

# ReactVision (shared by the team; ask Aminat for the key)
RV_API_KEY=ask-aminat
RV_PROJECT_ID=bce1b60b-7819-400d-bd26-5c6e0c006dee

# Apple signing (personal; only needed to build the iPhone app)
IOS_BUNDLE_ID=com.yourname.immerseed
APPLE_TEAM_ID=your-10-character-team-id

# Back-end address (FastAPI). On a phone, use your Mac's network address, not localhost.
EXPO_PUBLIC_API_URL=http://localhost:8000
